{
  "name": "Call Transcript Reviewer Ghl",
  "description": "Triggered by GHL webhook, fetches Dialpad call transcripts, reviews with Claude, saves scored results to Sheets.",
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "GHL Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "position": [
        0,
        300
      ],
      "parameters": {
        "path": "ghl-dialpad-review",
        "httpMethod": "POST",
        "responseData": "OK",
        "responseMode": "onReceived"
      },
      "typeVersion": 2.1
    },
    {
      "id": "extract-phone",
      "name": "Extract Phone Number",
      "type": "n8n-nodes-base.set",
      "position": [
        250,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "phone",
              "name": "phone_number",
              "type": "string",
              "value": "={{ $json.body.phone || $json.body.contact.phone || $json.body.phone_number }}"
            },
            {
              "id": "contact_name",
              "name": "contact_name",
              "type": "string",
              "value": "={{ $json.body.contact_name || $json.body.contact.name || $json.body.first_name + ' ' + $json.body.last_name || 'Unknown' }}"
            },
            {
              "id": "contact_email",
              "name": "contact_email",
              "type": "string",
              "value": "={{ $json.body.email || $json.body.contact.email || '' }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "search-dialpad-contact",
      "name": "Search Dialpad Contact",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        500,
        300
      ],
      "parameters": {
        "url": "https://[domain]/api/v2/contacts",
        "method": "GET",
        "sendQuery": true,
        "sendHeaders": true,
        "authentication": "[REDACTED]",
        "genericAuthType": "[REDACTED]",
        "queryParameters": {
          "parameters": [
            {
              "name": "phone_number",
              "value": "={{ $json.phone_number }}"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "typeVersion": 4.4
    },
    {
      "id": "get-dialpad-transcripts",
      "name": "Get Dialpad Transcripts",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        750,
        300
      ],
      "parameters": {
        "url": "=https://dialpad.com/api/v2/transcripts?contact_id={{ $json.items[0].id || $json.id }}",
        "method": "GET",
        "sendHeaders": true,
        "authentication": "[REDACTED]",
        "genericAuthType": "[REDACTED]",
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "typeVersion": 4.4
    },
    {
      "id": "prepare-transcripts",
      "name": "Prepare Transcripts for AI",
      "type": "n8n-nodes-base.set",
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "all_transcripts",
              "name": "all_transcripts",
              "type": "string",
              "value": "={{ JSON.stringify($json.items || $json.transcripts || $json) }}"
            },
            {
              "id": "contact_name",
              "name": "contact_name",
              "type": "string",
              "value": "={{ $('Extract Phone Number').item.json.contact_name }}"
            },
            {
              "id": "phone_number",
              "name": "phone_number",
              "type": "string",
              "value": "={{ $('Extract Phone Number').item.json.phone_number }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "ai-review-agent",
      "name": "Review Transcripts with Claude",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1250,
        300
      ],
      "parameters": {
        "text": "=Review the following call transcripts for contact \"{{ $json.contact_name }}\" (phone: {{ $json.phone_number }}).\n\nTRANSCRIPTS:\n{{ $json.all_transcripts }}\n\n---\n\nBased on your review, evaluate each requirement and indicate TRUE or FALSE for each checkbox item. Provide a brief reasoning for each decision.",
        "options": {
          "systemMessage": "You are a call transcript reviewer. Your job is to carefully analyze call transcripts and evaluate whether specific requirements were met during the conversations.\n\nINSTRUCTIONS:\n1. Read through ALL provided transcripts thoroughly.\n2. For each requirement/checkbox item, determine if the requirement was satisfied based on evidence in the transcripts.\n3. Mark each requirement as TRUE (met) or FALSE (not met).\n4. Provide a brief reasoning for each decision citing specific evidence from the transcripts.\n5. If a transcript is empty or unclear, mark the requirement as FALSE and note the lack of evidence.\n\nIMPORTANT: Base your evaluation ONLY on what is explicitly stated or clearly demonstrated in the transcripts. Do not make assumptions.\n\n[PLACEHOLDER: Replace this system message with your specific review criteria and requirements. For example:\n- Did the agent greet the customer by name?\n- Was the issue resolved on the call?\n- Did the agent offer follow-up support?\n- Was compliance language used?\n- etc.]"
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
    {
      "id": "claude-chat-model",
      "name": "Claude Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "position": [
        1150,
        520
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "[REDACTED]",
          "cachedResultName": "Claude Sonnet 4.5"
        },
        "options": {}
      },
      "typeVersion": 1.3
    },
    {
      "id": "output-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1350,
        520
      ],
      "parameters": {
        "autoFix": true,
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"contact_name\": \"John Doe\",\n  \"phone_number\": \"+1234567890\",\n  \"requirement_1_met\": true,\n  \"[REDACTED]\": \"Agent greeted the customer by name at the start of the call.\",\n  \"requirement_2_met\": false,\n  \"[REDACTED]\": \"No evidence of issue resolution found in transcripts.\",\n  \"requirement_3_met\": true,\n  \"[REDACTED]\": \"Agent offered follow-up support and scheduled a callback.\",\n  \"requirement_4_met\": false,\n  \"[REDACTED]\": \"Compliance language was not used during the conversation.\",\n  \"requirement_5_met\": true,\n  \"[REDACTED]\": \"Call summary was provided to the customer before ending.\",\n  \"overall_summary\": \"3 out of 5 requirements met. Key areas for improvement: issue resolution and compliance language.\"\n}"
      },
      "typeVersion": 1.3
    },
    {
      "id": "save-to-sheets",
      "name": "Save Results to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1500,
        300
      ],
      "parameters": {
        "columns": {
          "schema": [],
          "mappingMode": "autoMapInputData",
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {},
        "resource": "sheet",
        "operation": "append",
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        }
      },
      "typeVersion": 4.7
    },
    {
      "id": "sticky-note-1",
      "name": "Sticky Note - Setup",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -80,
        100
      ],
      "parameters": {
        "content": "## Setup Instructions\n\n1. **GHL Webhook**: Copy this webhook URL and paste it into your GoHighLevel outbound webhook settings\n2. **Dialpad API**: Set up HTTP Header Auth credentials with your Dialpad API key (header name: `Authorization`, value: `Bearer [REDACTED]\n3. **Claude AI**: Add your Anthropic API credentials\n4. **Google Sheets**: Connect your Google account and select your target spreadsheet\n5. **Customize**: Update the AI system prompt with your specific review requirements"
      },
      "typeVersion": 1
    },
    {
      "id": "sticky-note-2",
      "name": "Sticky Note - Customize",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1100,
        100
      ],
      "parameters": {
        "content": "## Customize AI Review\n\n**Edit the system message in 'Review Transcripts with Claude'** to define your specific requirements.\n\n**Edit the JSON example in 'Structured Output Parser'** to match your checkbox fields.\n\nThe output will be written as columns in your Google Sheet - TRUE/FALSE values will act as checkboxes."
      },
      "typeVersion": 1
    }
  ],
  "connections": {
    "Claude Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Review Transcripts with Claude",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "GHL Webhook Trigger": {
      "main": [
        [
          {
            "node": "Extract Phone Number",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Phone Number": {
      "main": [
        [
          {
            "node": "Search Dialpad Contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search Dialpad Contact": {
      "main": [
        [
          {
            "node": "Get Dialpad Transcripts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Dialpad Transcripts": {
      "main": [
        [
          {
            "node": "Prepare Transcripts for AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Structured Output Parser": {
      "ai_outputParser": [
        [
          {
            "node": "Review Transcripts with Claude",
            "type": "ai_outputParser",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Transcripts for AI": {
      "main": [
        [
          {
            "node": "Review Transcripts with Claude",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Review Transcripts with Claude": {
      "main": [
        [
          {
            "node": "Save Results to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}