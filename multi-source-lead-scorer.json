      {
        "id": "ai-agent",
        "name": "AI Lead Scorer",
        "type": "@n8n/n8n-nodes-langchain.agent",
        "position": [
          1000,
          400
        ],
        "parameters": {
          "text": "Score this lead from 1-10 based on the provided criteria. Here are the lead details:\n\nName: {{ $json.lead_name }}\nEmail: {{ $json.lead_email }}\nSource: {{ $json.lead_source }}\nMessage: {{ $json.lead_message }}\nCompany: {{ $json.lead_company }}\nBudget Signals: {{ $json.lead_budget }}\nTimestamp: {{ $json.lead_timestamp }}\n\nPlease analyze and score this lead based on:\n1. Budget signals (mentions of budget, pricing, cost) - 30% weight\n2. Urgency language (urgent, ASAP, immediately, deadline) - 40% weight  \n3. Company size indicators (enterprise, startup, team size) - 30% weight\n\nReturn your analysis in the specified JSON format.",
          "options": {
            "systemMessage": "You are an expert lead scoring AI assistant for a B2B sales organization. Your job is to analyze incoming leads and score them from 1-10 based on their likelihood to convert into high-value customers.\n\nScoring Criteria:\n- Budget Signals (30% weight): Look for explicit budget mentions, pricing inquiries, cost discussions, or financial readiness indicators\n- Urgency Language (40% weight): Identify time-sensitive language like \"urgent\", \"ASAP\", \"immediately\", \"deadline\", \"need by\", or specific timelines\n- Company Size (30% weight): Assess company indicators like \"enterprise\", \"Fortune 500\", team size mentions, or domain authority\n\nScoring Scale:\n- 1-3: Poor quality lead (no budget/urgency signals, unclear company info)\n- 4-6: Medium quality lead (some positive indicators but missing key elements)\n- 7-10: High quality lead (strong budget signals, urgent timeline, established company)\n\nAlways provide detailed reasoning for your score and be consistent in your analysis approach. Focus on objective indicators rather than assumptions."
          },
          "promptType": "define",
          "hasOutputParser": true
        },
        "typeVersion": 3.1
      },
      {
        "id": "output-parser",
        "name": "Structured Output Parser",
        "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
        "position": [
          1000,
          300
        ],
        "parameters": {
          "autoFix": false,
          "schemaType": "fromJson",
          "jsonSchemaExample": "{\n\t\"score\": 8,\n\t\"reasoning\": \"High-value lead from enterprise company with clear intent and specific use case mentioned\",\n\t\"key_indicators\": [\"enterprise company\", \"specific use case\", \"budget mentioned\", \"decision maker\"]\n}"
        },
        "typeVersion": 1.3
      },
      {
        "id": "route-score",
        "name": "Route by Score",
        "type": "n8n-nodes-base.if",
        "position": [
          1300,
          400
        ],
        "parameters": {
          "conditions": {
            "options": {
              "version": 3,
              "leftValue": "",
              "caseSensitive": false,
              "typeValidation": "strict"
            },
            "combinator": "and",
            "conditions": [
              {
                "id": "score_condition",
                "operator": {
                  "type": "number",
                  "operation": "gte",
                  "rightType": "number"
                },
                "leftValue": "={{ $json.score }}",
                "rightValue": 7
              }
            ]
          }
        },
        "typeVersion": 2.3
      },
