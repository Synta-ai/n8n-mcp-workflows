        "parameters": {
          "sendTo": "={{ $json.lead_email }}",
          "message": "=<p>Hi {{ $json.lead_name }},</p>\n\n<p>Thank you for reaching out to us via {{ $json.lead_source }}. We received your message and wanted to follow up personally.</p>\n\n<p><strong>Your inquiry:</strong><br>{{ $json.lead_message }}</p>\n\n<p>We would love to learn more about {{ $json.lead_company }} and how we can help. Here are some resources that might be helpful:</p>\n\n<ul>\n<li><a href=\"https://your-website.com/resources\">Resource Library</a></li>\n<li><a href=\"https://your-website.com/case-studies\">Success Stories</a></li>\n<li><a href=\"https://calendly.com/your-team/consultation\">Schedule a Free Consultation</a></li>\n</ul>\n\n<p>We will be reaching out again in a few days, but feel free to reply to this email or book a time that works for you.</p>\n\n<p>Best regards,<br>Your Sales Team</p>",
          "options": {},
          "subject": "Thank you for your interest - Lets connect!",
          "resource": "message",
