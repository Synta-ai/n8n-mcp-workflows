    {
      "id": "clean-html-post",
      "name": "Clean HTML",
      "type": "n8n-nodes-base.code",
      "position": [
        720,
        400
      ],
      "parameters": {
        "jsCode": "const html = $input.item.json.data || '';\n\nfunction extractByClass(html, className) {\n  const regex = new RegExp(`class=\"[^\"]*${className}[^\"]*\"[^>]*>([\\\\s\\\\S]*?)<\\/[^>]+>`, 'i');\n  const match = html.match(regex);\n  if (!match) return '';\n  return match[1].replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&nbsp;/g, ' ').trim();\n}\n\nfunction extractPostContent(html) {\n  const startMarker = '<div class=\"post-content\">';\n  const start = html.indexOf(startMarker);\n  if (start === -1) return '';\n  const block = html.slice(start + startMarker.length);\n  const cleaned = block\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/googletag[\\s\\S]*?;/g, '');\n  const paragraphs = [];\n  const pRegex = /<p[^>]*>([\\s\\S]*?)<\\/p>/gi;\n  let match;\n  while ((match = pRegex.exec(cleaned)) !== null) {\n    const text = match[1].replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&nbsp;/g, ' ').replace(/[ \\t]+/g, ' ').trim();\n    if (text && text.length > 40 && !text.includes('\u062c\u0645\u064a\u0639 \u0627\u0644\u062d\u0642\u0648\u0642 \u0645\u062d\u0641\u0648\u0638\u0629') && !text.includes('goud.ma') && !text.includes('googletag') && !text.includes('var ') && !text.includes('function ')) {\n      paragraphs.push(text);\n    }\n    if (paragraphs.length >= 8) break;\n  }\n  return paragraphs.join('\\n\\n');\n}\n\nreturn {\n  ...($input.item.json),\n  cleanTitle: extractByClass(html, 'entry-title'),\n  cleanContent: extractPostContent(html)\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "ai-post-web",
      "name": "Generate Post RS",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        960,
        400
      ],
      "parameters": {
        "text": "=\u0623\u0646\u062a \u0645\u062d\u0631\u0631 \u0635\u062d\u0641\u064a \u062e\u0628\u064a\u0631 \u0641\u064a \u0645\u0648\u0642\u0639 \u06af\u0648\u062f (goud.ma)\u060c \u0645\u062a\u062e\u0635\u0635 \u0641\u064a \u0643\u062a\u0627\u0628\u0629 \u0645\u0646\u0634\u0648\u0631\u0627\u062a \u0627\u0644\u0633\u0648\u0634\u064a\u0627\u0644 \u0645\u064a\u062f\u064a\u0627 \u0628\u0627\u0644\u062f\u0627\u0631\u062c\u0629 \u0627\u0644\u0645\u063a\u0631\u0628\u064a\u0629.\n\n\u0645\u0647\u0645\u062a\u0643: \u0627\u0643\u062a\u0628 \u0645\u0646\u0634\u0648\u0631 \u062a\u0634\u0648\u064a\u0642\u064a (teaser) \u064a\u062e\u0644\u064a \u0627\u0644\u0646\u0627\u0633 \u064a\u0643\u0644\u064a\u0643\u0648 \u0639\u0644\u0649 \u0627\u0644\u0644\u064a\u0646\u0643.\n\n=== \u0627\u0644\u0642\u0648\u0627\u0639\u062f ===\n1. \u0627\u0644\u062f\u0627\u0631\u062c\u0629 \u0627\u0644\u0645\u063a\u0631\u0628\u064a\u0629 \u0628\u0627\u0644\u062d\u0631\u0641 \u0627\u0644\u0639\u0631\u0628\u064a\n2. \u062c\u0645\u0644\u0629 \u0623\u0648\u0644\u0649 \u0635\u0627\u062f\u0645\u0629 \u0623\u0648 \u0645\u062b\u064a\u0631\u0629 \u0644\u0644\u0641\u0636\u0648\u0644\n3. \u0623\u0639\u0637\u064a \u0641\u0643\u0631\u0629 \u0639\u0627\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u062e\u0628\u0631 \u2014 \u0628\u0644\u0627 \u062a\u0641\u0627\u0635\u064a\u0644\n4. \u062e\u0644\u064a \u0634\u064a \u0645\u0639\u0644\u0648\u0645\u0629 \u0646\u0627\u0642\u0635\u0629 \u0628\u0627\u0634 \u0627\u0644\u0648\u0627\u062d\u062f \u064a\u0643\u0644\u064a\u0643\n5. 2 \u0625\u0644\u0649 3 \u062c\u0645\u0644 \u0641\u0642\u0637\n6. \u0627\u062e\u062a\u0645 \u0628 \"\u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0639\u0646\u062f \u06af\u0648\u062f \ud83d\udc47\"\n7. \u0628\u062f\u0648\u0646 \u0647\u0627\u0634\u062a\u0627\u0642\u0627\u062a \u0641\u064a \u0627\u0644\u0646\u0635\u060c \u0628\u062f\u0648\u0646 \u0625\u064a\u0645\u0648\u062c\u064a\n\n=== \u0627\u0644\u0645\u0642\u0627\u0644 ===\n\u0627\u0644\u0639\u0646\u0648\u0627\u0646: {{ $json.cleanTitle }}\n\u0627\u0644\u0645\u062d\u062a\u0648\u0649: {{ $json.cleanContent }}\n\n=== \u0627\u0644\u0645\u0637\u0644\u0648\u0628 ===\n\u0627\u0643\u062a\u0628 \u0641\u0642\u0637 JSON \u0647\u0643\u0630\u0627 \u0628\u062f\u0648\u0646 \u0623\u064a \u0634\u0631\u062d:\n{\n  \"post\": \"\u0646\u0635 \u0627\u0644\u0628\u0648\u0633\u062a \u0647\u0646\u0627\",\n  \"hashtags\": \"#\u0647\u0627\u0634\u062a\u0627\u06421 #\u0647\u0627\u0634\u062a\u0627\u06422 #\u0647\u0627\u0634\u062a\u0627\u06423 #\u0647\u0627\u0634\u062a\u0627\u06424 #\u0647\u0627\u0634\u062a\u0627\u06425\"\n}",
        "agent": "toolsAgent",
