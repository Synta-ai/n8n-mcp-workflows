    {
      "id": "scrape-meta-web",
      "name": "Scrape Title & Photo",
      "type": "n8n-nodes-base.code",
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const html = $input.item.json.data;\nconst url = $('Webhook Scrape').item.json.body.url;\n\nlet title = '';\nconst ogTitle = html.match(/<meta[^>]+property=[\"']og:title[\"'][^>]+content=[\"']([^\"']+)[\"']/i);\nconst titleTag = html.match(/<title[^>]*>([^<]+)<\\/title>/i);\nif (ogTitle) title = ogTitle[1];\nelse if (titleTag) title = titleTag[1];\ntitle = title.replace(/ - \u0643\u0648\u062f.*$/, '').replace(/ - \u06af\u0648\u062f.*$/, '').trim();\n\nlet photo = '';\nconst ogImage = html.match(/<meta[^>]+property=[\"']og:image[\"'][^>]+content=[\"']([^\"']+)[\"']/i);\nconst ogImage2 = html.match(/<meta[^>]+content=[\"']([^\"']+)[\"'][^>]+property=[\"']og:image[\"']/i);\nif (ogImage) photo = ogImage[1];\nelse if (ogImage2) photo = ogImage2[1];\n\nif (!title || !photo) throw new Error('Impossible de scraper titre ou photo');\n\nreturn { title, photo, url };"
      },
      "typeVersion": 2
    },
