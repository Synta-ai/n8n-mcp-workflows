            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp to Admin": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Social Caption": {
      "main": [
        [
          {
            "node": "Create Branded Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Structured Output Parser": {
      "ai_outputParser": [
        [
          {
            "node": "Generate Social Caption",
            "type": "ai_outputParser",
            "index": 0
          }
        ]
      ]
    },
    "Webhook WordPress Publish": {
      "main": [
        [
          {
            "node": "Fetch Full Article",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}